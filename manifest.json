{
  "manifest_version": 3,
  "name": "트윗덱 클래식 UI",
  "version": "1.0.0",
  "description": "X(트위터) 화면을 예전 트윗덱(TweetDeck) 느낌의 어둡고 촘촘한 컬럼형 디자인으로 바꿔주는 확장 프로그램",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "트윗덱 클래식 UI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*", "https://mobile.twitter.com/*", "https://mobile.x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
