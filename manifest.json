{
    "name": "구 트윗덱 커스텀 (OldTweetDeck Custom)",
    "description": "OldTweetDeck(dimdenGD, MIT License)의 포크: 구 트윗덱 기능은 그대로 두고 색상·모양 직접 커스터마이징, 리퀴드 글래스 모드, 직접 올리는 이미지 스티커를 추가했습니다.",
    "version": "4.4.0",
    "manifest_version": 3,
    "homepage_url": "https://github.com/G909G09/TweetDeck-Classic-Custom",
    "permissions": [
        "webNavigation",
        "cookies",
        "declarativeNetRequest",
        "storage",
        "unlimitedStorage"
    ],
    "background": {
        "service_worker": "src/background3.js"
    },
    "host_permissions": [
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://abs.twimg.com/*",
        "https://api.twitter.com/*",
        "https://tweetdeck.com/",
        "https://oldtd.org/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["images/*", "files/*", "src/*", "solver.html", "manifest.json"],
            "matches": ["<all_urls>"]
        }
    ],
    "declarative_net_request": {
        "rule_resources" : [{
          "id": "ruleset",
          "enabled": true,
          "path": "ruleset.json"
        }]
      },
    "icons": {
        "16": "/images/logo16.png",
        "32": "/images/logo32.png",
        "48": "/images/logo48.png",
        "128": "/images/logo128.png"
    },
    "action": {
        "default_popup": "custom/popup.html",
        "default_title": "구 트윗덱 커스텀"
    },
    "content_scripts": [
        {
            "matches": ["https://twitter.com/i/tweetdeck", "https://x.com/i/tweetdeck", "https://x.com/i/tweetdeck?*"],
            "js": ["src/content.js"],
            "all_frames": true,
            "run_at": "document_start"
        },
        {
            "matches": ["https://twitter.com/i/tweetdeck", "https://x.com/i/tweetdeck", "https://x.com/i/tweetdeck?*"],
            "js": ["src/destroyer.js", "src/notifications.js", "src/injection.js"],
            "all_frames": true,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://twitter.com/i/tweetdeck", "https://x.com/i/tweetdeck", "https://x.com/i/tweetdeck?*"],
            "js": ["custom/customize.js"],
            "css": ["custom/theme.css"],
            "run_at": "document_idle"
        }
    ]
}
